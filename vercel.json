{
  "rewrites": [
    {
      "source": "/api/tournaments/:id",
      "destination": "/api/tournaments"
    },
    {
      "source": "/api/matches/:id",
      "destination": "/api/matches"
    },
    {
      "source": "/api/tournaments",
      "destination": "/api/tournaments"
    },
    {
      "source": "/api/matches",
      "destination": "/api/matches"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
